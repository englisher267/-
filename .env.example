# 哲鉄日々 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env
#
# 重要: .env はコミットしないこと（.gitignoreに含まれています）

# =====================
# Notion MCP
# https://www.notion.so/profile/integrations でAPIキーを取得
# =====================
NOTION_API_KEY=secret_xxxxxxxxxxxx

# =====================
# Google Calendar MCP
# Google Cloud Consoleでプロジェクトを作成し、OAuth2クレデンシャルを取得
# https://console.cloud.google.com/
# =====================
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/callback

# =====================
# Obsidian MCP
# Obsidianに「Local REST API」プラグインをインストールして起動する必要があります
# https://github.com/coddingtonbear/obsidian-local-rest-api
# =====================
OBSIDIAN_API_KEY=xxxxxxxxxxxx
OBSIDIAN_HOST=http://localhost:27123

# =====================
# GitHub MCP
# https://github.com/settings/tokens でPATを取得（repo権限）
# =====================
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxx
